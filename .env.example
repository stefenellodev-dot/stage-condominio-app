# Conexión Supabase (PRODUCCION)
# IMPORTANTE: La app se conecta a condo-sb-db (postgres DB) via api.ecomunity.cl
# NO usar svc-db/condosmart (schema en espanol, es legacy/desarrollo)
# La BD de produccion tiene schema en ingles (condominiums, management_companies, units, etc.)
VITE_SUPABASE_URL=https://api.ecomunity.cl
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Identidad y Branding de la Aplicación
VITE_APP_NAME=Sistema de Administración de Condominios
VITE_APP_TAGLINE="Starter Kit Base"
VITE_APP_SYMBOL="S"
